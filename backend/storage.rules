rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Media uploads use Firebase Auth UID in the path so Storage rules match `request.auth.uid`.
    match /encrypted-media/{uid}/{allPaths=**} {
      // Owner uploads and reads their own objects. Friends download ciphertext through
      // the getEncryptedMediaReadUrl callable (short-lived signed URL), not by listing this prefix.
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}

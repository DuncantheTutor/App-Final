# Copy to backend/functions/.env before deploying Cloud Functions.
# SHA-256 of the app signing certificate, hex, no colons.
# Print it with:
#   keytool -list -v -keystore <your-release.keystore> -alias <alias>
# The debug keystore in this repo is public. Pinning it does not stop a rebuilt app.
PAIRING_ATTESTATION_CERT_SHA256=
